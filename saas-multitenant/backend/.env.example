# Configuração do Banco de Dados PostgreSQL
# Renomeie este arquivo para .env e preencha com seus dados

# URL de conexão do banco de dados
# Exemplos:
# Local: postgresql://usuario:senha@localhost:5432/nome_do_banco
# Neon/Cloud: postgresql://usuario:senha@host.cloud.provider.com:5432/nome_do_banco
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chronostek

# Porta do servidor backend
PORT=5000

# Chave secreta para JWT (mude para uma chave segura em produção)
JWT_SECRET=seu_jwt_secret_aqui_mude_em_producao

# URL do frontend em produção (para CORS e CSP)
# Ex: https://crmultas.vercel.app ou https://crm.seudominio.com.br
FRONTEND_URL=

# Configurações do Node.js
NODE_ENV=development

